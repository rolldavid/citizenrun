{
  "name": "citizenrun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @citizenrun/api --filter @citizenrun/worker --filter @citizenrun/mobile run dev",
    "build:web": "pnpm --filter @citizenrun/mobile run build:web",
    "build:api": "pnpm --filter @citizenrun/db run build && pnpm --filter @citizenrun/api run build",
    "build:worker": "pnpm --filter @citizenrun/db run build && pnpm --filter @citizenrun/worker run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project 'unit:*' --project 'dom:*'",
    "test:integration": "vitest run --project 'int:*'",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:gen && pnpm check:db && pnpm check:i18n && pnpm check:licenses && pnpm test && pnpm test:integration && pnpm build:web && pnpm check:bundle",
    "gen": "pnpm gen:brand && pnpm gen:api",
    "gen:brand": "tsx scripts/gen-brand.ts",
    "gen:api": "pnpm --filter @citizenrun/api run gen:openapi && pnpm --filter @citizenrun/shared run gen:client",
    "db:migrate": "pnpm --filter @citizenrun/db run migrate",
    "db:seed": "pnpm --filter @citizenrun/db run seed",
    "db:reset": "pnpm --filter @citizenrun/db run reset && pnpm db:migrate && pnpm db:seed",
    "db:generate": "pnpm --filter @citizenrun/db run generate",
    "e2e:web": "pnpm --filter @citizenrun/mobile run e2e:web",
    "stack:local": "tsx scripts/e2e-stack.ts --up --build",
    "ci:local": "tsx scripts/ci-local.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:gen": "tsx scripts/check-gen.ts",
    "check:db": "pnpm --filter @citizenrun/db run check"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "esbuild": "catalog:",
    "vitest": "catalog:",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.2",
    "@typescript-eslint/rule-tester": "8.72.2",
    "eslint-config-expo": "58.0.4",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-presigned-post": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@citizenrun/shared": "workspace:*",
    "zod": "catalog:",
    "yaml": "2.9.1",
    "railway": "3.17.0",
    "@railway/cli": "5.74.0"
  }
}
