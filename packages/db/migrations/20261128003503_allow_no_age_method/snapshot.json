      "key": "checks\u0000[\"public\",\"state_rules\",\"state_rules_age_method_check\"]",
      "set": {
        "value": "\"age_method\" in ('store_signal_required', 'store_signal_or_dob', 'store_signal_or_none')"
      }
    }
