      "op": "alter",
      "key": "checks\u0000[\"public\",\"users\",\"users_age_method_check\"]",
      "set": {
        "value": "\"age_method\" in ('store_signal', 'self_declared', 'none')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"users\",\"users_age_record_check\"]",
      "set": {
        "value": "case when \"age_method\" is null then num_nulls(\"age_result\", \"age_source_tier\", \"age_checked_at\") = 3 when \"age_method\" = 'none' then \"age_result\" is null and \"age_source_tier\" is null and \"age_checked_at\" is not null else num_nulls(\"age_result\", \"age_source_tier\", \"age_checked_at\") = 0 end"
      }
    },
