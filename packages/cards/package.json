{
  "name": "@citizenrun/cards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./primitives": {
      "react-native": "./src/primitives/native.ts",
      "default": "./src/primitives/dom.ts"
    },
    "./server": "./src/server/render-png.ts",
    "./assets/fonts/*": "./assets/fonts/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen": "tsx scripts/gen-advance-widths.ts && tsx scripts/gen-illustrations.ts"
  },
  "dependencies": {
    "@citizenrun/shared": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native-svg": "15.16.x"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "fontkit": "3.0.0",
    "react": "catalog:",
    "sharp": "~0.35.5",
    "svgo": "4.1.0"
  }
}
