  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./storage": "./src/storage/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
