          },
          "poster": {
            "$ref": "#/components/schemas/MediaVariant"
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "key",
          "url",
          "width",
          "height",
          "blurhash",
          "thumb",
          "poster",
          "durationMs"
        ]
      },
      "MediaVariant": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "url",
          "width",
          "height"
        ]
      },
      "NonceResult": {
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string"
          },
          "nonceHash": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "nonce",
          "nonceHash",
          "state",
          "expiresAt"
        ]
      },
      "OnboardingStep": {
        "type": "string",
        "enum": [
          "photo",
          "handle",
          "issues",
          "location",
          "done"
        ]
      },
      "OpenApiDocument": {
        "type": "object",
        "additionalProperties": {}
      },
      "ReadyzResponse": {
        "type": "object",
        "properties": {
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "worker": {
            "type": "string",
            "enum": [
              "ok",
              "stale",
              "unknown"
            ]
          }
        },
        "required": [
          "db",
          "worker"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "string",
              "null"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "created": {
            "type": "boolean"
          },
          "me": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "created",
          "me"
        ]
      },
      "SessionState": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
