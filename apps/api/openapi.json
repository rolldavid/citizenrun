{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-os_session"
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_cursor",
                  "client_header_required",
                  "not_found",
                  "payload_too_large",
                  "upgrade_required",
                  "rate_limited",
                  "internal",
                  "unavailable"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 200
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "required",
                    "invalid_type",
                    "too_short",
                    "too_long",
                    "too_few",
                    "too_many",
                    "out_of_range",
                    "invalid_format",
                    "invalid_value",
                    "not_allowed"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "fields"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "OpenApiDocument": {
        "type": "object",
        "additionalProperties": {}
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "tags": [
          "reference"
        ],
        "x-route": {
          "auth": "none",
          "rateLimit": "ref.openapi",
          "public": true,
          "clientHeader": "exempt"
        },
        "x-errors": [
          "rate_limited"
        ],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
