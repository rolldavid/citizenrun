{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-os_session"
      }
    },
    "schemas": {
      "AgeRecord": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "store_signal",
              "self_declared"
            ]
          },
          "sourceTier": {
            "type": "string",
            "enum": [
              "confirmed",
              "declared",
              "self"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "method",
          "sourceTier",
          "checkedAt"
        ]
      },
      "ClientErrorFrame": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_\\-/.@]+$"
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "required": [
          "file",
          "line",
          "column"
        ]
      },
      "ConsentState": {
        "type": "object",
        "properties": {
          "terms": {
            "$ref": "#/components/schemas/DocumentConsent"
          },
          "contentPolicy": {
            "$ref": "#/components/schemas/DocumentConsent"
          },
          "privacyPolicy": {
            "$ref": "#/components/schemas/DocumentConsent"
          },
          "aiScreening": {
            "type": "string",
            "enum": [
              "granted",
              "declined",
              "not_asked"
            ]
          },
          "needed": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "terms",
                "content_policy",
                "privacy_policy"
              ]
            }
          }
        },
        "required": [
          "terms",
          "contentPolicy",
          "privacyPolicy",
          "aiScreening",
          "needed"
        ]
      },
      "CreateAuthNonceBody": {
        "type": "object",
        "properties": {}
      },
      "CreateClientErrorBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_$.]+$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          },
          "route": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\/[A-Za-z0-9_\\-/[\\]().+]*$"
          },
          "component": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_$.]+$"
          },
          "appVersion": {
            "type": "string",
            "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientErrorFrame"
            },
            "maxItems": 20
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "code",
          "route",
          "component",
          "appVersion",
          "platform",
          "frames",
          "requestId"
        ]
      },
      "DocumentConsent": {
        "type": "object",
        "properties": {
          "agreedVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "currentVersion": {
            "type": "string"
          }
        },
        "required": [
          "agreedVersion",
          "currentVersion"
        ]
      },
      "EmailStartResult": {
        "type": "object",
        "properties": {
          "pendingToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "pendingToken",
          "expiresAt",
          "resendAvailableAt"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_cursor",
                  "client_header_required",
                  "not_found",
                  "payload_too_large",
                  "upgrade_required",
                  "rate_limited",
                  "internal",
                  "unavailable",
                  "signature_invalid",
                  "unauthenticated",
                  "forbidden",
                  "origin_rejected",
                  "account_suspended",
                  "recent_sign_in_required",
                  "onboarding_incomplete",
                  "daily_limit_reached",
                  "email_undeliverable",
                  "email_signin_paused",
                  "code_invalid",
                  "code_expired",
                  "code_attempts_exhausted",
                  "identity_token_invalid",
                  "nonce_invalid",
                  "handoff_invalid",
                  "provider_not_configured",
                  "signup_details_required",
                  "consent_version_outdated",
                  "signup_limit_reached",
                  "account_deleting",
                  "reauth_mismatch",
                  "email_already_set",
                  "email_in_use",
                  "handle_taken",
                  "handle_reserved",
                  "handle_change_too_soon",
                  "ai_consent_required",
                  "unknown_issue",
                  "upload_invalid",
                  "onboarding_step_mismatch",
                  "export_not_ready",
                  "unavailable_in_state",
                  "age_signal_required",
                  "upload_too_large"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 200
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "required",
                    "invalid_type",
                    "too_short",
                    "too_long",
                    "too_few",
                    "too_many",
                    "out_of_range",
                    "invalid_format",
                    "invalid_value",
                    "not_allowed"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "fields"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthzResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "LogoutBody": {
        "type": "object",
        "properties": {}
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
