  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealthz",
        "tags": [
          "web"
        ],
        "x-route": {
          "auth": "none",
          "rateLimit": "web_health"
        },
        "x-errors": [
          "rate_limited"
        ],
        "responses": {
          "200": {
            "description": "The process can serve a request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthzResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadyz",
        "tags": [
          "web"
        ],
        "x-route": {
          "auth": "none",
          "rateLimit": "web_health"
        },
        "x-errors": [
          "unavailable",
          "rate_limited"
        ],
        "responses": {
          "200": {
            "description": "The database answers; the worker heartbeat is fresh or stale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer, or the process is draining.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/email/start": {
      "post": {
        "operationId": "startEmailSignIn",
        "tags": [
          "auth"
        ],
        "x-route": {
          "auth": "none",
          "rateLimit": "auth.emailStart",
          "public": true
        },
        "x-errors": [
          "invalid_request",
          "client_header_required",
          "origin_rejected",
          "email_undeliverable",
          "rate_limited",
          "email_signin_paused",
          "unavailable"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartEmailSignInBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The challenge, its expiry and the earliest resend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailStartResult"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The request-forgery check failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Email to this address is not deliverable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Email sign-in is paused, or the mail provider failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/email/verify": {
      "post": {
        "operationId": "verifyEmailSignIn",
        "tags": [
          "auth"
        ],
        "x-route": {
          "auth": "optional",
          "rateLimit": "auth.emailVerify",
          "public": true,
          "allowWhenSuspended": true
        },
        "x-errors": [
          "invalid_request",
          "unauthenticated",
          "origin_rejected",
          "account_deleting",
          "unavailable_in_state",
          "age_signal_required",
          "reauth_mismatch",
          "email_already_set",
          "email_in_use",
          "code_expired",
          "code_invalid",
          "code_attempts_exhausted",
          "signup_details_required",
          "consent_version_outdated",
          "rate_limited",
          "signup_limit_reached"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
