              "web"
            ]
          },
          "authenticatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sensitiveActionsUntil": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "platform",
          "authenticatedAt",
          "expiresAt",
          "sensitiveActionsUntil"
        ]
      },
      "SignupDetails": {
        "type": "object",
        "properties": {
          "age": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "store_signal",
                  "self_declared"
                ]
              },
              "sourceTier": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "declared",
                  "self"
                ]
              }
            },
            "required": [
              "method",
              "sourceTier"
            ]
          },
          "agreements": {
            "type": "object",
            "properties": {
              "termsVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "contentPolicyVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "privacyPolicyVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "required": [
              "termsVersion",
              "contentPolicyVersion",
              "privacyPolicyVersion"
            ]
          },
          "aiScreening": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "state": {
