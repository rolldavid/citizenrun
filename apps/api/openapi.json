          "onboardedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "newAccountUntil": {
            "type": "string",
            "format": "date-time"
          },
          "handleChangeAvailableAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserIssue"
            }
          },
          "locale": {
            "type": "string"
          },
          "age": {
            "$ref": "#/components/schemas/AgeRecord"
          },
          "consents": {
            "$ref": "#/components/schemas/ConsentState"
          },
          "session": {
            "$ref": "#/components/schemas/SessionState"
          }
        },
        "required": [
          "id",
          "handle",
          "name",
          "bio",
          "link",
          "avatar",
          "avatarPending",
          "email",
          "emailStatus",
          "signInMethods",
          "role",
          "status",
          "suspension",
          "onboardingStep",
          "onboardedAt",
          "createdAt",
          "newAccountUntil",
          "handleChangeAvailableAt",
          "issues",
          "locale",
          "age",
          "consents",
          "session"
        ]
      },
      "Media": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "kind": {
            "type": "string",
