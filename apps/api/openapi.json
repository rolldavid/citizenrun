      "StartEmailSignInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email"
          },
          "pendingToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "SuspendedReason": {
        "type": "string",
        "enum": [
          "content_policy",
          "spam",
          "impersonation",
          "copyright",
          "under_18",
          "legal",
          "other"
        ]
      },
      "UserIssue": {
        "type": "object",
        "properties": {
          "issueId": {
            "type": "string"
          },
          "starred": {
            "type": "boolean"
          }
        },
        "required": [
          "issueId",
          "starred"
        ]
      },
      "VerifyEmailSignInBody": {
        "type": "object",
        "properties": {
          "pendingToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "intent": {
            "type": "string",
            "enum": [
              "sign_in",
              "reauth",
              "add_email"
            ],
            "default": "sign_in"
