{
  "name": "@citizenrun/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsx ../../scripts/build-service.ts src/server.ts dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "gen:openapi": "tsx src/scripts/gen-openapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@citizenrun/db": "workspace:*",
    "@citizenrun/shared": "workspace:*",
    "@hono/node-server": "2.1.11",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "catalog:",
    "hono": "4.13.19",
    "jose": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  }
}
