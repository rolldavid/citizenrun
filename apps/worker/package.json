{
  "name": "@citizenrun/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsx ../../scripts/build-service.ts src/main.ts dist/main.js && tsx ../../scripts/build-service.ts src/backup/main.ts dist/backup.js --no-externals",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@citizenrun/db": "workspace:*",
    "@citizenrun/shared": "workspace:*",
    "blurhash": "2.0.5",
    "drizzle-orm": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "resend": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
