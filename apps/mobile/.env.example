APP_VARIANT=development
# Set only when a phone on your network must reach the API at your computer's address:
# EXPO_PUBLIC_API_ORIGIN=http://192.168.1.20:8080
# src/lib/env.ts reads an empty sign-in id as unset, which hides that button: local sign-in is by email unless you fill them in.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICES_ID=
