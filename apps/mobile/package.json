{
  "name": "@citizenrun/mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx ../../scripts/copy-web-fonts.ts && expo start --port 8081",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:web": "tsx ../../scripts/copy-web-fonts.ts && expo export --platform web --source-maps --output-dir dist && tsx ../../scripts/assert-web-export.ts",
    "typecheck": "tsc -p tsconfig.native.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run && vitest run --config vitest.dom.config.ts",
    "e2e:web": "playwright test",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@citizenrun/cards": "workspace:*",
    "@citizenrun/shared": "workspace:*",
    "@expo/ui": "~58.0.29",
    "@formatjs/intl-pluralrules": "7.1.0",
    "@maplibre/maplibre-react-native": "~11.5.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "catalog:",
    "expo": "~58.0.26",
    "expo-age-range": "~58.0.3",
    "expo-apple-authentication": "~58.0.3",
    "expo-build-properties": "~58.0.12",
