{
  "cli": { "version": ">= 27.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "24.22.3", "pnpm": "12.21.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "APP_VARIANT": "development" }
    },
    "development-simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "APP_VARIANT": "staging" },
      "android": { "buildType": "apk" }
    },
    "e2e": {
      "extends": "base",
      "withoutCredentials": true,
      "env": { "APP_VARIANT": "development" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    },
    "closed-test": {
      "extends": "base",
      "channel": "closed-test",
      "environment": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "API_VARIANT": "staging" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}
