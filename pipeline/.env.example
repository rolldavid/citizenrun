# The data bucket is the pipeline's home until staging exists; only the pipeline and the stand-in's worker read it.
DATA_BUCKET=data
DATA_ENDPOINT=http://localhost:8333
DATA_REGION=us-east-1
DATA_ACCESS_KEY_ID=osdev
DATA_SECRET_ACCESS_KEY=osdev-secret-key
S3_FORCE_PATH_STYLE=true
LOG_LEVEL=debug
# FEC_API_KEY is an owner value, left empty here; while it is empty the lookups that need it are skipped.
FEC_API_KEY=
